datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum RoadmapCategory {
  DEVELOPMENT
  DATA_SCIENCE
  SYSTEMS
  PREPARATION
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ResourceType {
  WEBSITE
  YOUTUBE
  DOCUMENTATION
  BOOK
  COURSE
  GITHUB
  PRACTICE
  PROJECT_TUTORIAL
  INTERVIEW_PREP
}

enum ApplicationStatus {
  SAVED
  APPLIED
  OA
  INTERVIEW
  HR
  OFFER
  REJECTED
}

enum DsaStatus {
  TODO
  ATTEMPTED
  SOLVED
}

enum ProjectStatus {
  TODO
  IN_PROGRESS
  COMPLETED
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  password       String?
  name           String?
  image          String?
  role           Role           @default(USER)
  streak         Int            @default(0)
  lastActive     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  
  progress       UserProgress[]
  applications   Application[]
  dsaProblems    DSAProblem[]
  projects       Project[]
  notes          Note[]
  bookmarks      Bookmark[]
  studyPlans     StudyPlan[]
  resumeProfiles ResumeProfile[]
  resumeAnalyses ResumeAnalysis[]
  skillProgress  UserSkillProgress[]
}

model Roadmap {
  id           String          @id @default(uuid())
  slug         String          @unique
  title        String
  description  String
  difficulty   Difficulty
  estimatedTime String
  category     RoadmapCategory
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  nodes        RoadmapNode[]
  bookmarks    Bookmark[]
  userProgress UserProgress[]
  projects     Project[]
}

model RoadmapNode {
  id            String         @id @default(uuid())
  roadmapId     String
  roadmap       Roadmap        @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  slug          String
  title         String
  description   String
  difficulty    Difficulty
  estimatedTime String
  prerequisites String[]
  parentNodeId  String?
  order         Int            @default(0)
  
  resources     Resource[]
  userProgress  UserProgress[]
  notes         Note[]
  bookmarks     Bookmark[]

  @@unique([roadmapId, slug])
}

model Resource {
  id            String       @id @default(uuid())
  title         String
  type          ResourceType
  url           String
  isApproved    Boolean      @default(false)
  
  roadmapNodeId String?
  roadmapNode   RoadmapNode? @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  roadmapId     String?
  submittedBy   String?
  
  createdAt     DateTime     @default(now())
}

model UserProgress {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId     String
  roadmap       Roadmap      @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapNodeId String
  roadmapNode   RoadmapNode  @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  
  completed     Boolean      @default(false)
  bookmarked    Boolean      @default(false)
  notes         String?      @db.Text
  lastUpdated   DateTime     @default(now()) @updatedAt

  @@unique([userId, roadmapNodeId])
}

model Application {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          String
  role             String
  type             String
  location         String
  package          String
  applicationLink  String?
  appliedDate      DateTime          @default(now())
  deadline         DateTime?
  status           ApplicationStatus @default(SAVED)
  referralContact  String?
  resumeVersion    String?
  notes            String?           @db.Text
  followUpReminder DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model DSAProblem {
  id              String      @id @default(uuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  platform        String
  topic           String
  difficulty      Difficulty
  status          DsaStatus   @default(TODO)
  attempts        Int         @default(0)
  solutionLink    String?
  revisionDate    DateTime?
  confidenceLevel Int         @default(3)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Project {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId   String?
  roadmap     Roadmap?      @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  title       String
  description String
  repoUrl     String?
  demoUrl     String?
  difficulty  Difficulty
  status      ProjectStatus @default(TODO)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Note {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNodeId String
  roadmapNode   RoadmapNode @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  content       String      @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([userId, roadmapNodeId])
}

model Bookmark {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId     String?
  roadmap       Roadmap?     @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  roadmapNodeId String?
  roadmapNode   RoadmapNode? @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  createdAt     DateTime     @default(now())

  @@unique([userId, roadmapId, roadmapNodeId])
}

model StudyPlan {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  durationDays Int
  planJson     Json
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model ResumeProfile {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalDetails Json
  education      Json
  skills         Json
  projects       Json
  experience     Json
  achievements   Json
  certifications Json
  links          Json
  template       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ResumeAnalysis {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetCompany    String
  targetRole       String
  resumeText       String   @db.Text
  jobDescription   String   @db.Text
  overallScore     Int
  sectionScores    Json
  missingSkills    String[]
  missingKeywords  String[]
  improvementChecklist Json
  recommendedRoadmaps String[]
  createdAt        DateTime @default(now())
}

model UserSkillProgress {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain           String   // e.g., "frontend", "backend"
  xp               Int      @default(0)
  unlockedSkills   String[]
  completedSkills  String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, domain])
}

